---
# gdrive-fuse clang-format configuration
# Style: Google base, adjusted for 4-space indent and project conventions
BasedOnStyle: Google

# Indentation
IndentWidth: 4
ContinuationIndentWidth: 4
AccessModifierOffset: -4
NamespaceIndentation: None

# Column limit
ColumnLimit: 100

# Braces
BreakBeforeBraces: Attach

# Includes
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  # Project headers first
  - Regex: '^"gdrive_fuse/'
    Priority: 1
  # Standard library
  - Regex: '^<[a-z_]+>$'
    Priority: 3
  # Third-party
  - Regex: '^<'
    Priority: 2

# Alignment
AlignConsecutiveAssignments:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false
AlignConsecutiveMacros:
  Enabled: true
AlignTrailingComments:
  Kind: Always

# Pointer and reference alignment
PointerAlignment: Left
ReferenceAlignment: Left

# Function parameters
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# Template and constructor
BreakConstructorInitializers: BeforeColon
PackConstructorInitializers: CurrentLine

# Penalties (discourage long lines, but allow aligned code)
PenaltyBreakBeforeFirstCallParameter: 1
PenaltyReturnTypeOnItsOwnLine: 200

# Spaces
SpaceBeforeParens: ControlStatements
SpaceAfterCStyleCast: false
SpacesInAngles: Never

# C++ specific
Standard: c++20
